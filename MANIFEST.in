include VERSION
include tools/check_release.py
include CHANGELOG.md
recursive-include Example *.yaml *.csv *.md
include tests/conftest.py

# Git ignores do not control source distributions.
exclude jprel
prune docs
prune .github
prune .claude
prune .codex
prune .agents
prune .cursor
prune .idea
prune .vscode
prune .aws
prune .ssh
prune .twine
prune .pypi
prune .venv
prune venv
prune env
prune .cache
prune .pytest_cache
prune .ruff_cache
prune .mypy_cache
prune .tox
prune .nox
prune .ipynb_checkpoints
global-exclude .DS_Store *.py[cod] .env .env.* .envrc .pypirc .pypirc.* .twinerc .pypi-token* .mcp.json release.env twine.env *.code-workspace *.swp *.swo *~ *.bak *.tmp
prune bin
prune Workshop
prune Example/plots
prune Example/.cache
prune Example/forest/plots
prune Example/forest/.cache
