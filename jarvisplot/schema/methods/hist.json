{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis-plot.org/schema/v2/methods/hist.json",
  "title": "method: hist",
  "description": "Coordinate contract for layers[].method='hist' (matplotlib: hist). Required axes must appear under coordinates.",
  "x-jarvis-zone": "closed",
  "x-jarvis-method": "hist",
  "x-jarvis-mpl": "hist",
  "x-jarvis-axes-types": [
    "rect",
    "any"
  ],
  "x-jarvis-coordinates": {
    "required": [
      "x"
    ],
    "optional": [
      "weights"
    ],
    "alternatives": []
  },
  "x-jarvis-example": "method: hist\ncoordinates:\n  x: {expr: x}",
  "type": "object",
  "properties": {
    "method": {
      "const": "hist"
    },
    "coordinates": {
      "type": "object",
      "x-jarvis-zone": "delegated",
      "additionalProperties": true,
      "description": "Required axes for hist: x. Optional: weights."
    }
  },
  "additionalProperties": true
}
