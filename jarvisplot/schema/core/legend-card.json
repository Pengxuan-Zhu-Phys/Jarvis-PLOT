{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis-plot.org/schema/v2/core/legend-card.json",
  "title": "Legend format card",
  "type": "object",
  "x-jarvis-zone": "closed",
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string"
    },
    "extends": {
      "type": "string",
      "minLength": 1
    },
    "legend": {
      "type": "object",
      "x-jarvis-zone": "delegated",
      "properties": {
        "prop": {"$ref": "#/$defs/fontProperties"}
      },
      "propertyNames": {
        "not": {
          "enum": [
            "card",
            "preset",
            "item_formats",
            "entries",
            "order",
            "axes",
            "enabled",
            "handles",
            "labels"
          ]
        }
      },
      "additionalProperties": true
    },
    "items": {
      "type": "object",
      "x-jarvis-zone": "closed",
      "additionalProperties": {
        "$ref": "#/$defs/itemFormatOverride"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "fontProperties": {
      "description": "Native legend font properties. Ordinary text and mathematical glyphs are configured independently.",
      "anyOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "x-jarvis-zone": "delegated",
          "properties": {
            "family": {
              "oneOf": [
                {"type": "string", "minLength": 1},
                {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
              ]
            },
            "size": {
              "oneOf": [
                {"type": "number", "exclusiveMinimum": 0},
                {"type": "string", "minLength": 1}
              ],
              "description": "Legend text size in points (or a native relative size). Overrides legend.fontsize."
            },
            "math_fontfamily": {
              "enum": ["stix", "dejavusans"],
              "default": "stix",
              "description": "STIX serif mathematical glyphs by default; dejavusans restores the previous DejaVu Sans appearance. This does not enable MathText parsing."
            },
            "weight": {"type": ["string", "number"]},
            "style": {"enum": ["normal", "italic", "oblique"]}
          },
          "additionalProperties": true
        }
      ]
    },
    "itemFormat": {
      "type": "object",
      "x-jarvis-zone": "closed",
      "required": [
        "roles",
        "key"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "key": {
          "enum": [
            "overlay",
            "stack"
          ]
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "itemFormatOverride": {
      "type": "object",
      "x-jarvis-zone": "closed",
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "key": {
          "enum": [
            "overlay",
            "stack"
          ]
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
