{
    "Contract": {
        "figure_type": "correlation_matrix",
        "axes": "axcorr",
        "colorbar": "axccorr",
        "exclusive": true,
        "geometry": "solved",
        "layout": "diamond",
        "note": "Reserved card, own family. The upper triangle turned 45 degrees: u = (j - i) / 2 across, v = (i + j) / 2 down, so one variable's pairs are a single V rooted at its own name and the names are an ordinary column of horizontal text. Solved by Figure/corr_layout_diamond.py from the row pitch and bounded by the page height -- the square card is anchored on the cell and bounded by the width, which is why the two do not share a solver."
    },
    "Geometry": {
        "units": "mm",
        "pitch": 4.2,
        "pitch_min": 2.6,
