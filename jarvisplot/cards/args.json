{
    "commands": [
        {
            "name": "validate",
            "help": "check a YAML config without rendering it",
            "usage": "jplot validate <file> [--json] [--fix [--diff|--write]]",
            "kind": "agent"
        },
        {
            "name": "cap",
            "help": "list legal strings (methods, styles, cmaps, funcs, …)",
            "usage": "jplot cap [all|methods|transforms|types|styles|cmaps|funcs|cli] [--json]",
            "kind": "agent"
        },
        {
            "name": "data",
            "help": "inspect a data file (describe / head / eval / suggest-axes)",
            "usage": "jplot data describe|head|eval|suggest-axes … [--json]",
            "kind": "agent"
        },
        {
            "name": "flowchart",
            "help": "render a Jarvis-HEP flowchart scene JSON",
            "usage": "jplot flowchart <flowchart_file>",
            "kind": "legacy"
        }
    ],
    "positionals": [
        {
            "name": "file",
            "help": "YAML to render (bare path = plot; not a verb — see DR-08)"
        },
        {
            "name": "flowchart_file",
            "help": "path to the input flowchart scene JSON",
            "nargs": "?"
        }
    ],
    "options": [
        {
            "short": "-v",
            "long": "--version",
            "dest": "version",
            "help": "show JarvisPLOT version",
            "action": "version"
        },
        {
            "short": "-d",
            "long": "--debug",
            "dest": "debug",
            "help": "run Jarvis-PLOT in debug mode",
            "action": "store_true"
        },
        {
            "long": "--parse-data",
            "dest": "parse_data",
            "help": "parse datasets and update YAML metadata",
            "action": "store_true"
        },
        {
            "long": "--out",
            "dest": "out",
            "help": "output YAML path or flowchart image path",
            "action": "store",
            "metavar": "PATH"

        },
        {
            "long": "--inplace",
            "dest": "inplace",
            "help": "modify the input YAML file in place",
            "action": "store_true"
        },
        {
            "long": "--print",
            "dest": "no_logo",
            "help": "disable the Jarvis-HEP logo panel",
            "action": "store_true"
        },
        {
            "long": "--rebuild-cache",
            "dest": "rebuild_cache",
            "help": "rebuild the project cache before plotting",
            "action": "store_true"
        }
    ]
}
