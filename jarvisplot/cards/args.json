{
    "positionals": [
        {
            "name": "file",
            "help": "path of the input YAML file, or the command 'flowchart'"
        },
        {
            "name": "flowchart_file",
            "help": "path of the input flowchart JSON file when using: jplot flowchart path-to-flowchart.json",
            "nargs": "?"
        }
    ],
    "options": [
        {
            "short": "-v",
            "long": "--version",
            "dest": "version",
            "help": "show JarvisPLOT version",
            "action": "version"
        },
        {
            "short": "-d",
            "long": "--debug",
            "dest": "debug",
            "help": "Run JarvisPLOT in debug mode",
            "action": "store_true"
        },
        {
            "long": "--parse-data",
            "dest": "parse_data",
            "help": "Parse datasets (CSV/HDF5), sanitize column names, and write Variables/ColumnMap back to YAML",
            "action": "store_true"
        },
        {
            "long": "--out",
            "dest": "out",
            "help": "Output YAML path (used with --parse-data), or output image path/dir for 'jplot flowchart'",
            "action": "store",
            "metavar": "PATH"

        },
        {
            "long": "--inplace",
            "dest": "inplace",
            "help": "Modify the input YAML file in place (used with --parse-data)",
            "action": "store_true"
        },
        {
            "long": "--print",
            "dest": "no_logo",
            "help": "Disable the Jarvis-HEP logo panel (axlogo)",
            "action": "store_true"
        },
        {
            "long": "--rebuild-cache",
            "dest": "rebuild_cache",
            "help": "Ignore and rebuild workdir/.cache before plotting",
            "action": "store_true"
        }
    ]
}
