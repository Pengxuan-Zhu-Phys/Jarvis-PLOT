{
    "help_groups": [
        {
            "title": "Discover",
            "commands": [
                "data",
                "cap",
                "man",
                "explain"
            ]
        },
        {
            "title": "Draft & edit",
            "commands": [
                "template",
                "suggest",
                "config"
            ]
        },
        {
            "title": "Judge",
            "commands": [
                "validate",
                "dryrun",
                "doctor"
            ]
        },
        {
            "title": "Render",
            "commands": [
                "file"
            ]
        },
        {
            "title": "Flowchart",
            "commands": [
                "flowchart"
            ]
        }
    ],
    "commands": [
        {
            "name": "data",
            "help": "inspect a data file (describe / head / eval / suggest-axes)",
            "usage": "jplot data describe|head|eval|suggest-axes … [--json]",
            "kind": "agent",
            "group": "Discover"
        },
        {
            "name": "cap",
            "help": "list legal strings (methods, styles, cmaps, funcs, …)",
            "usage": "jplot cap [all|methods|transforms|types|styles|cmaps|funcs|cli] [--json]",
            "kind": "agent",
            "group": "Discover"
        },
        {
            "name": "man",
            "help": "callable manual (index or topic; --json for agents)",
            "usage": "jplot man [topic] [--json]",
            "kind": "agent",
            "group": "Discover"
        },
        {
            "name": "explain",
            "help": "explain a JP-* code or expand type: figures to layers",
            "usage": "jplot explain <JP-CODE|yaml> [--json]",
            "kind": "agent",
            "group": "Discover"
        },
        {
            "name": "template",
            "help": "list/show type-first YAML templates + slots",
            "usage": "jplot template list|show <kind> [--json]",
            "kind": "agent",
            "group": "Draft & edit"
        },
        {
            "name": "suggest",
            "help": "synthesize a YAML from a data file (kind + columns)",
            "usage": "jplot suggest --data <file> --kind posterior_2d [--x …] [--json]",
            "kind": "agent",
            "group": "Draft & edit"
        },
        {
            "name": "config",
            "help": "read/write YAML by named address (get / paths / set / rm / expand)",
            "usage": "jplot config get|set|rm|paths|expand … [--json] [--write]",
            "kind": "agent",
            "group": "Draft & edit"
        },
        {
            "name": "validate",
            "help": "check a YAML config without rendering it",
            "usage": "jplot validate <file> [--json] [--fix [--diff|--write]]",
            "kind": "agent",
            "group": "Judge"
        },
        {
            "name": "dryrun",
            "help": "load data + transforms, row ledger + JP-VIZ health (no render)",
            "usage": "jplot dryrun <file> [--json] [--with-data]",
            "kind": "agent",
            "group": "Judge"
        },
        {
            "name": "doctor",
            "help": "validate + dryrun in one pass",
            "usage": "jplot doctor <file> [--json]",
            "kind": "agent",
            "group": "Judge"
        },
        {
            "name": "flowchart",
            "help": "Jarvis-HEP project-scan flowchart only (scene JSON from HEP scan tooling — not general plot YAML)",
            "usage": "jplot flowchart <flowchart_file>",
            "kind": "legacy",
            "group": "Flowchart"
        }
    ],
    "positionals": [
        {
            "name": "file",
            "help": "YAML to render (bare path; not a verb — DR-08)",
            "group": "Render"
        },
        {
            "name": "flowchart_file",
            "help": "Jarvis-HEP scan flowchart scene JSON (not a plot config)",
            "nargs": "?"
        }
    ],
    "options": [
        {
            "short": "-v",
            "long": "--version",
            "dest": "version",
            "help": "show JarvisPLOT version",
            "action": "version"
        },
        {
            "short": "-d",
            "long": "--debug",
            "dest": "debug",
            "help": "run Jarvis-PLOT in debug mode",
            "action": "store_true"
        },
        {
            "long": "--parse-data",
            "dest": "parse_data",
            "help": "parse datasets and update YAML metadata",
            "action": "store_true"
        },
        {
            "long": "--out",
            "dest": "out",
            "help": "with --parse-data: output YAML path; with flowchart: image path. Does NOT redirect normal figure PNG/PDF (those use YAML output.dir)",
            "action": "store",
            "metavar": "PATH"
        },
        {
            "long": "--inplace",
            "dest": "inplace",
            "help": "with --parse-data: rewrite the input YAML in place (not for figure images)",
            "action": "store_true"
        },
        {
            "long": "--print",
            "dest": "no_logo",
            "help": "disable the Jarvis-HEP logo panel",
            "action": "store_true"
        },
        {
            "long": "--rebuild-cache",
            "dest": "rebuild_cache",
            "help": "rebuild the project cache before plotting",
            "action": "store_true"
        },
        {
            "long": "--report",
            "dest": "report",
            "help": "write ephemeral render-health report JSON next to the YAML (JP-VIZ etc.); delete after final plots",
            "action": "store_true"
        }
    ]
}
